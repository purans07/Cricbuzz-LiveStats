# Optional local settings. Copy to private .env; process environment wins.
DATA_MODE=sample
DATABASE_URL=sqlite:///data/runtime/sample.db
DISPLAY_TIMEZONE=Asia/Kolkata
APP_ACCESS_MODE=local
# Select a separately initialized live target only when live setup is verified:
# DATA_MODE=live
# DATABASE_URL=sqlite:///data/runtime/live.db
# Phase 9 transport: requires a reviewed manifest for one provider/version.
# The live-list route is confirmed; supply only a regenerated key privately.
CRICBUZZ_CONTRACT_FILE=api/contracts/cricketapilive_v2.json
# CRICBUZZ_API_KEY=replace-in-private-env-only
# API URL/header/endpoint/HTTP policies belong in the reviewed manifest.
# Server backends require a distinct SELECT-only reader on the same database.
# DATABASE_URL=postgresql+psycopg://writer:PRIVATE_PASSWORD@localhost:5432/cricbuzz
# READ_DATABASE_URL=postgresql+psycopg://reader:PRIVATE_PASSWORD@localhost:5432/cricbuzz
# MySQL uses mysql+pymysql:// with the same writer/reader separation.
